using System.IO;
using UnrealBuildTool;

public class SoloASJitConsumer : ModuleRules
{
    public SoloASJitConsumer(ReadOnlyTargetRules Target) : base(Target)
    {
        PCHUsage = PCHUsageMode.UseExplicitOrSharedPCHs;
        bUseUnity = false;
        PrivateDependencyModuleNames.AddRange(new[] { @DEPENDENCIES@ });
        PrivateIncludePaths.Add(Path.Combine(EngineDirectory, "Source", "Runtime"));
    }
}
